# ============================================================
#  .gitignore —— 优学鲸
#
#  核心原则: **公开的是知识图谱与代码, 不是试题原文。**
#  以下前几项是「绝对不能上传」的内容, 请勿删除。
# ============================================================

# ------------------------------------------------------------
# 1) 试题与答案的原始材料 —— 版权内容, 严禁上传
#    408 考研真题试卷/答案解析的 PDF 原件 (约 62MB)
# ------------------------------------------------------------
.cache/

# 从 PDF 中渲染出的答案表扫描图 (用于人工核对, 仍属真题内容)
_research/

# 临时解包/中间产物
_extract/

# ------------------------------------------------------------
# 2) 含试题原文的完整题库 —— 保留在本地
#    data/408/
data/math/*.json 里含题干、选项、答案原文。
#    对外只发布已剥离原文的 data/graph/ 与 data/syllabus/。
# ------------------------------------------------------------
data/408/
data/math/

# ------------------------------------------------------------
# 3) 项目内部笔记 —— 含个人与协作策略信息, 不宜公开
# ------------------------------------------------------------
.workbuddy/

# ------------------------------------------------------------
# 4) 常规忽略
# ------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.env
.DS_Store
*.log

# ------------------------------------------------------------
# 5) 真题插图 —— 与原卷同属版权内容, 不公开
#    (题干里的「如图」指向它们, 但图本身是原卷的一部分)
# ------------------------------------------------------------
data/figures/

# ------------------------------------------------------------
# 6) 产品层运行时数据 —— 用户作答记录, 不进版本控制
# ------------------------------------------------------------
data/yj.db
data/*.db

# ------------------------------------------------------------
# 7) 预跑快照 —— 内含配套习题的题干, 与原卷同属版权内容
# ------------------------------------------------------------
data/prewarm/

# ---- 界面截图（开发/评审用，不进仓库）----
_shots/

# ---- 综合题参考答案（从答案册 PDF 抽取，与原卷同属版权内容）----
data/solutions

# ---- SQLite WAL 模式产生的副文件（WAL 让 streamlit 与 nicegui 能并发读写）----
data/*.db-wal
data/*.db-shm

# ---- LLM 密钥（绝不进仓库）----
.streamlit/secrets.toml

# ---- 考研政治真题数据（题目与答案，与题源同属版权内容）----
data/zhengzhi

# NiceGUI 会话/缓存
.nicegui/

# 部署
.env
backups/
